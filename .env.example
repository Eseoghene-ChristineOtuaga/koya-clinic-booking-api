# For LOCAL DEVELOPMENT ONLY; do not commit .env or your credentials.
# In Supabase -> Connect, select "Transaction pooler" (port 6543).
# For SQLAlchemy, prepend postgresql+psycopg:// to the provided URL.
# Percent-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
API_KEY=replace-with-strong-random-secret
